{
  "manifest_version": 3,
  "name": "OneDrive / SharePoint PDF Download Unlocker",
  "version": "1.3.0",
  "version_name": "1.3.0",
  "description": "Download preview-only OneDrive / SharePoint PDFs in one click, and export view-only PowerPoint-for-web slides to PDF.",
  "permissions": [
    "webRequest",
    "webNavigation",
    "downloads",
    "activeTab",
    "storage",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "*://*.sharepoint.com/*",
    "*://*.sharepointonline.com/*",
    "*://onedrive.live.com/*",
    "*://*.officeapps.live.com/*",
    "*://1drv.ms/*",
    "*://*.svc.ms/*",
    "*://*.mcas.ms/*",
    "*://login.microsoftonline.com/*",
    "*://login.windows.net/*",
    "*://spoprod-a.akamaihd.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OneDrive / SharePoint PDF Download Unlocker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.sharepoint.com/*",
        "*://*.sharepointonline.com/*",
        "*://onedrive.live.com/*",
        "*://*.officeapps.live.com/*",
        "*://*.mcas.ms/*"
      ],
      "js": [
        "i18n.js",
        "util.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.officeapps.live.com/*"
      ],
      "js": [
        "i18n.js",
        "util.js",
        "slidepdf.js",
        "slides-viewer.js",
        "slides.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
